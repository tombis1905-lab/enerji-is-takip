generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PERSONEL
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String
  name        String
  role        Role      @default(PERSONEL)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isKayitlari IsKaydi[]
  akaryakitKayitlari AkaryakitKaydi[]
  depoHareketleri DepoHareketi[]
}

model Santiye {
  id          String    @id @default(cuid())
  ad          String
  konum       String?
  aktif       Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isKayitlari IsKaydi[]
}

model IsTuru {
  id          String    @id @default(cuid())
  ad          String    @unique
  birim       String
  aktif       Boolean   @default(true)
  createdAt   DateTime  @default(now())
  isKayitlari IsKaydi[]
}

model IsKaydi {
  id          String        @id @default(cuid())
  tarih       DateTime
  miktar      Float
  aciklama    String?
  userId      String
  santiyeId   String
  isTuruId    String
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id])
  santiye     Santiye       @relation(fields: [santiyeId], references: [id])
  isTuru      IsTuru        @relation(fields: [isTuruId], references: [id])
  fotograflar IsKaydiFoto[]

  @@index([userId])
  @@index([santiyeId])
  @@index([tarih])
  @@index([isTuruId])
}

model Arac {
  id          String    @id @default(cuid())
  plaka       String    @unique
  isim        String?
  marka       String?
  model       String?
  aktif       Boolean   @default(true)
  sigortaBitisTarihi DateTime?
  muayeneBitisTarihi DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  akaryakitKayitlari AkaryakitKaydi[]
}

model AkaryakitKaydi {
  id          String    @id @default(cuid())
  tarih       DateTime
  tutar       Float
  fisNo       String?
  aciklama    String?
  aracId      String
  userId      String
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  arac        Arac      @relation(fields: [aracId], references: [id])
  user        User      @relation(fields: [userId], references: [id])

  @@index([aracId])
  @@index([tarih])
  @@index([userId])
}

model IsKaydiFoto {
  id               String   @id @default(cuid())
  cloudStoragePath String
  isPublic         Boolean  @default(true)
  contentType      String   @default("image/jpeg")
  isKaydiId        String
  createdAt        DateTime @default(now())
  isKaydi          IsKaydi  @relation(fields: [isKaydiId], references: [id], onDelete: Cascade)

  @@index([isKaydiId])
}

enum DepoHareketTipi {
  GIRIS
  CIKIS
}

model DepoMalzeme {
  id          String         @id @default(cuid())
  ad          String         @unique
  birim       String
  stokMiktari Float          @default(0)
  minStok     Float?
  aciklama    String?
  aktif       Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  hareketler  DepoHareketi[]
}

model DepoHareketi {
  id        String          @id @default(cuid())
  tarih     DateTime
  tip       DepoHareketTipi
  miktar    Float
  aciklama  String?
  malzemeId String
  userId    String
  createdAt DateTime        @default(now())
  malzeme   DepoMalzeme     @relation(fields: [malzemeId], references: [id])
  user      User            @relation(fields: [userId], references: [id])

  @@index([malzemeId])
  @@index([tarih])
  @@index([userId])
}

model Sirket {
  id                 String            @id @default(cuid())
  ad                 String            @unique
  aktif              Boolean           @default(true)
  createdAt          DateTime          @default(now())
  personelSirketleri PersonelSirket[]
}

// Şantiyede fiilen çalışan personel (isim listesi). Uygulamaya giriş yapan
// kullanıcı hesaplarından (User) bağımsızdır — şifre gerekmez, sadece
// hangi şirkette ne zaman çalıştıklarını takip etmek içindir.
model Calisan {
  id            String           @id @default(cuid())
  ad            String
  telefon       String?
  aciklama      String?
  aktif         Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  sirketGecmisi PersonelSirket[]
}

// İhale/proje portföy takibi (Çevre Şehircilik ve benzeri kurumlardan alınan
// işler): mali bilgiler, takvim, kesin teminat mektubu ve hakediş takibi.
model Ihale {
  id            String    @id @default(cuid())
  isAdi         String
  kurum         String
  ihaleKayitNo  String?
  ihaleGrupNo   String?
  projeNumarasi String?

  yaklasikMaliyet Float?
  sozlesmeBedeli  Float?
  ekIsBedeli      Float?

  ihaleTarihi           DateTime?
  sozlesmeTarihi        DateTime?
  yerTeslimTarihi       DateTime?
  sozlesmeSuresiGun     Int?
  isBitimTarihi         DateTime?
  isBitimTarihiRevize   DateTime?
  sureUzatimBitisTarihi DateTime?

  geciciKabulTarihi  DateTime?
  geciciKabulSayisi  String?
  kesinKabulTarihi   DateTime?
  kesinKabulSayisi   String?
  ilisiksizlikTarihi DateTime?
  ilisiksizlikSayisi String?

  kesinTeminatMektubu1      Float?
  kesinTeminatMektubu2      Float?
  kesinTeminatMektubuSuresi DateTime?
  kesinTeminatSureUzatimi   DateTime?

  hakedis1     Float?
  hakedis2     Float?
  hakedis3     Float?
  hakedis4     Float?
  hakedisKesin Float?

  tedasKirimOrani Float?

  aciklama  String?
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([aktif])
  @@index([isBitimTarihi])
}

model PersonelSirket {
  id              String    @id @default(cuid())
  calisanId       String
  sirketId        String
  baslangicTarihi DateTime
  bitisTarihi     DateTime?
  aciklama        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  calisan         Calisan   @relation(fields: [calisanId], references: [id], onDelete: Cascade)
  sirket          Sirket    @relation(fields: [sirketId], references: [id])

  @@index([calisanId])
  @@index([sirketId])
  @@index([bitisTarihi])
}

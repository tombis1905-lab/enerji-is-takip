generator client {
    provider = "prisma-client-js"
    binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PERSONEL
}

model User {
  id          String    @id @default(cuid())
  email       String    @unique
  password    String
  name        String
  role        Role      @default(PERSONEL)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isKayitlari IsKaydi[]
  akaryakitKayitlari AkaryakitKaydi[]
  depoHareketleri DepoHareketi[]
}

model Santiye {
  id          String    @id @default(cuid())
  ad          String
  konum       String?
  aktif       Boolean   @default(true)
  // Proje Maliyeti sayfasında üst düzey gruplama: KASKI / CEVRE_SEHIRCILIK / OZEL.
  // Boşsa "Kategorisiz" altında gösterilir.
  kategori    String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  isKayitlari IsKaydi[]

  projeMalzemeleri   ProjeMalzeme[]
  projeAraclar       ProjeArac[]
  projeAracGunleri   ProjeAracGun[]
  projeMaliyetOzeti  ProjeMaliyetOzet?
  projePersonelHarcamalari ProjePersonelHarcama[]
  projeEkMaliyetleri ProjeEkMaliyet[]
  akaryakitKayitlari AkaryakitKaydi[]
  calisanGunlukKonumlari CalisanGunlukKonum[]
  faturalar   Fatura[]
}

model IsTuru {
  id               String        @id @default(cuid())
  ad               String        @unique
  birim            String
  aktif            Boolean       @default(true)
  // İşaretlenirse: bu iş türüne girilen İş Kaydı bir aracın/iş makinesinin
  // (ör. kepçe) yakıt harcamasıdır — miktar alanı TL tutarı olarak girilir ve
  // seçilen araç zorunlu olur; kayıt otomatik olarak Akaryakıt listesine
  // (ve dolayısıyla o şantiyenin Proje Maliyeti akaryakıt toplamına) yansır.
  akaryakitTakibi  Boolean       @default(false)
  createdAt        DateTime      @default(now())
  isKayitlari      IsKaydi[]
  projeMalzemeleri ProjeMalzeme[]
}

model IsKaydi {
  id          String        @id @default(cuid())
  tarih       DateTime
  miktar      Float
  aciklama    String?
  userId      String
  santiyeId   String
  isTuruId    String
  // Opsiyonel: bu iş bir araç/iş makinesi (ör. kepçe) tarafından yapıldıysa.
  // isTuru.akaryakitTakibi=true ise ZORUNLU olur — miktar (TL) otomatik
  // olarak bu aracın Akaryakıt kaydına işlenir (bkz. lib/proje-akaryakit-sync.ts).
  aracId      String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  user        User          @relation(fields: [userId], references: [id])
  santiye     Santiye       @relation(fields: [santiyeId], references: [id])
  isTuru      IsTuru        @relation(fields: [isTuruId], references: [id])
  arac        Arac?         @relation(fields: [aracId], references: [id])
  fotograflar IsKaydiFoto[]
  akaryakitKaydiOtomatik AkaryakitKaydi?

  @@index([userId])
  @@index([santiyeId])
  @@index([tarih])
  @@index([isTuruId])
  @@index([aracId])
}

model Arac {
  id          String    @id @default(cuid())
  plaka       String    @unique
  isim        String?
  marka       String?
  model       String?
  aktif       Boolean   @default(true)
  sahiplik    AracSahiplik @default(KENDI)
  sigortaBitisTarihi DateTime?
  muayeneBitisTarihi DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  akaryakitKayitlari AkaryakitKaydi[]
  isKayitlari        IsKaydi[]

  projeAraclar     ProjeArac[]
  projeAracGunleri ProjeAracGun[]
}

// KENDI: şirketin sahip olduğu araç. KIRALIK: günlük/haftalık kiralanan veya
// dışarıdan tutulan araç — yalnızca bu tip Proje Maliyeti'nde araç yevmiyesi
// gideri olarak takip edilir (kendi araçlarımızın günlük "kiralama bedeli" olmaz).
enum AracSahiplik {
  KENDI
  KIRALIK
}

model AkaryakitKaydi {
  id          String    @id @default(cuid())
  tarih       DateTime
  tutar       Float
  fisNo       String?
  aciklama    String?
  aracId      String
  userId      String
  // Opsiyonel: bu yakıt harcaması belirli bir şantiye içinse, o şantiyenin
  // Proje Maliyeti'ndeki akaryakıt toplamına otomatik olarak eklenir (elle
  // girilen akaryakitTutar alanının ÜSTÜNE, ayrı bir kalem olarak).
  santiyeId   String?
  // Doldurulmuşsa bu kayıt elle değil, bir İş Kaydı'ndan (akaryakitTakibi=true
  // olan bir iş türü + araç seçilerek) OTOMATİK oluşturulmuştur — o İş Kaydı
  // silinirse/değişirse bu kayıt da otomatik silinir/güncellenir, elle
  // düzenlenmemesi/silinmemesi gerekir (bkz. lib/proje-akaryakit-sync.ts).
  kaynakIsKaydiId String? @unique
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  arac        Arac      @relation(fields: [aracId], references: [id])
  user        User      @relation(fields: [userId], references: [id])
  santiye     Santiye?  @relation(fields: [santiyeId], references: [id])
  kaynakIsKaydi IsKaydi? @relation(fields: [kaynakIsKaydiId], references: [id], onDelete: Cascade)

  @@index([aracId])
  @@index([tarih])
  @@index([userId])
  @@index([santiyeId])
}

model IsKaydiFoto {
  id               String   @id @default(cuid())
  cloudStoragePath String
  isPublic         Boolean  @default(true)
  contentType      String   @default("image/jpeg")
  isKaydiId        String
  createdAt        DateTime @default(now())
  isKaydi          IsKaydi  @relation(fields: [isKaydiId], references: [id], onDelete: Cascade)

  @@index([isKaydiId])
}

enum DepoHareketTipi {
  GIRIS
  CIKIS
}

model DepoMalzeme {
  id          String         @id @default(cuid())
  ad          String         @unique
  birim       String
  stokMiktari Float          @default(0)
  minStok     Float?
  aciklama    String?
  aktif       Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  hareketler  DepoHareketi[]
}

model DepoHareketi {
  id        String          @id @default(cuid())
  tarih     DateTime
  tip       DepoHareketTipi
  miktar    Float
  aciklama  String?
  malzemeId String
  userId    String
  createdAt DateTime        @default(now())
  malzeme   DepoMalzeme     @relation(fields: [malzemeId], references: [id])
  user      User            @relation(fields: [userId], references: [id])

  @@index([malzemeId])
  @@index([tarih])
  @@index([userId])
}

model Sirket {
  id                 String            @id @default(cuid())
  ad                 String            @unique
  aktif              Boolean           @default(true)
  createdAt          DateTime          @default(now())
  personelSirketleri PersonelSirket[]
  cekler             Cek[]
  faturalar          Fatura[]
  haftalikOdemeler   HaftalikOdeme[]
}

enum CekTuru {
  ALINAN
  VERILEN
}

enum CekDurumu {
  BEKLEMEDE
  TAHSIL_EDILDI
  CIRO_EDILDI
  KARSILIKSIZ
  IPTAL
}

// Çek takibi: sadece Yönetici + ek PIN ile açılan ayrı "Çekler" bölümü.
// Alınan (müşteriden) ve verilen (tedarikçiye) çekler tek tabloda, tür alanıyla ayrılır.
model Cek {
  id              String     @id @default(cuid())
  tur             CekTuru
  cekNo           String?
  banka           String?
  sube            String?
  karsiTaraf      String?
  tutar           Float
  vadeTarihi      DateTime
  duzenlemeTarihi DateTime?
  durum           CekDurumu  @default(BEKLEMEDE)
  sirketId        String?
  sirket          Sirket?    @relation(fields: [sirketId], references: [id])
  aciklama        String?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([vadeTarihi])
  @@index([durum])
  @@index([tur])
  @@index([sirketId])
}

// Şantiyede fiilen çalışan personel (isim listesi). Uygulamaya giriş yapan
// kullanıcı hesaplarından (User) bağımsızdır — şifre gerekmez, sadece
// hangi şirkette ne zaman çalıştıklarını takip etmek içindir.
model Calisan {
  id            String           @id @default(cuid())
  ad            String
  telefon       String?
  // Personelin varsayılan/sürekli çalıştığı bölge — "ilk kayıt": Tom bunu
  // değiştirmediği sürece personelin her gün burada çalıştığı varsayılır.
  bolge         String?
  // bolge alanı en son NE ZAMAN bu değere ayarlandı (ilk atamada ya da bolge
  // değiştirildiğinde güncellenir) — "kaç gündür bu bölgede" hesaplamak için.
  bolgeBaslangicTarihi DateTime?
  // ASIL = bizim kendi personelimiz, TASERON = taşeron firma personeli
  personelTipi  String           @default("ASIL")
  aciklama      String?
  aktif         Boolean          @default(true)
  createdAt     DateTime         @default(now())
  updatedAt     DateTime         @updatedAt
  sirketGecmisi PersonelSirket[]
  gunlukKonumlar CalisanGunlukKonum[]
}

// Puantaj benzeri istisna kaydı: bir personel varsayılan bölgesinin (Calisan.bolge)
// dışında, belirli bir GÜN için başka bir şantiyede çalıştıysa buraya tek satır
// eklenir (ör. "Ferhat Kılıç normalde Botaş'ta ama 12.09'da X şantiyesine gitti").
// Tom bir değişiklik girmediği sürece personel varsayılan bölgesinde çalışıyor
// sayılır; bu tablo yalnızca istisnaları/o günlük değişiklikleri tutar.
// santiyeId boş (null) ise bu "Özel" bir kayıttır — o gün hiçbir şantiyede
// değil (ör. ofiste, araç yıkama, izin) demektir; açıklama alanında detay tutulur.
model CalisanGunlukKonum {
  id        String   @id @default(cuid())
  calisanId String
  calisan   Calisan  @relation(fields: [calisanId], references: [id], onDelete: Cascade)
  tarih     DateTime
  santiyeId String?
  santiye   Santiye? @relation(fields: [santiyeId], references: [id])
  aciklama  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([calisanId])
  @@index([tarih])
  @@index([santiyeId])
}

// İhale/proje portföy takibi (Çevre Şehircilik ve benzeri kurumlardan alınan
// işler): mali bilgiler, takvim, kesin teminat mektubu ve hakediş takibi.
model Ihale {
  id            String    @id @default(cuid())
  isAdi         String
  kurum         String
  ihaleKayitNo  String?
  ihaleGrupNo   String?
  projeNumarasi String?

  yaklasikMaliyet Float?
  sozlesmeBedeli  Float?
  ekIsBedeli      Float?

  ihaleTarihi           DateTime?
  sozlesmeTarihi        DateTime?
  yerTeslimTarihi       DateTime?
  sozlesmeSuresiGun     Int?
  isBitimTarihi         DateTime?
  isBitimTarihiRevize   DateTime?
  sureUzatimBitisTarihi DateTime?

  geciciKabulTarihi  DateTime?
  geciciKabulSayisi  String?
  kesinKabulTarihi   DateTime?
  kesinKabulSayisi   String?
  ilisiksizlikTarihi DateTime?
  ilisiksizlikSayisi String?

  kesinTeminatMektubu1      Float?
  kesinTeminatMektubu2      Float?
  kesinTeminatMektubuSuresi DateTime?
  kesinTeminatSureUzatimi   DateTime?

  hakedis1     Float?
  hakedis2     Float?
  hakedis3     Float?
  hakedis4     Float?
  hakedisKesin Float?

  tedasKirimOrani Float?

  aciklama  String?
  aktif     Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([aktif])
  @@index([isBitimTarihi])
}

model PersonelSirket {
  id              String    @id @default(cuid())
  calisanId       String
  sirketId        String
  baslangicTarihi DateTime
  bitisTarihi     DateTime?
  aciklama        String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  calisan         Calisan   @relation(fields: [calisanId], references: [id], onDelete: Cascade)
  sirket          Sirket    @relation(fields: [sirketId], references: [id])

  @@index([calisanId])
  @@index([sirketId])
  @@index([bitisTarihi])
}

enum FaturaTuru {
  KESILEN
  ALINAN
}

enum FaturaOdemeDurumu {
  BEKLIYOR
  ODENDI
  GECIKTI
}

// Fatura takibi: sadece Yönetici + ek PIN ile açılan ayrı "Faturalar" bölümü
// (Çekler ile aynı PIN'i kullanır). Kestiğimiz (KESILEN) ve aldığımız (ALINAN)
// faturalar tek tabloda, tür alanıyla ayrılır. PDF nüshası isteğe bağlı olarak
// yerel diskte (Railway Volume) saklanır, yolu pdfYolu alanında tutulur.
model Fatura {
  id              String            @id @default(cuid())
  tur             FaturaTuru
  faturaNo        String?
  tarih           DateTime
  aciklama        String?
  karsiTaraf      String?
  tutar           Float
  kdvOrani        Float             @default(20)
  kdvTutari       Float
  kdvDahilTutar   Float
  tevkifatTutari  Float?
  vadeTarihi      DateTime?
  odemeDurumu     FaturaOdemeDurumu @default(BEKLIYOR)
  sirketId        String?
  sirket          Sirket?           @relation(fields: [sirketId], references: [id])
  pdfYolu         String?
  pdfDosyaAdi     String?
  // Haftalık Ödemeler görünümü için: gerçek ödeme tarihi, ödemenin yapıldığı
  // IBAN bilgisi ve işi yapan yüklenici/taşeron adı. Üçü de opsiyonel — dolu
  // olan aldığımız (ALINAN) faturalar otomatik olarak haftalık ödemeler
  // tablosunda kendi haftasına düşer.
  odemeTarihi     DateTime?
  ibanBilgisi     String?
  yuklenici       String?
  // Bu fatura hangi şantiye için kesildi/alındı — opsiyonel. Dolu olduğunda
  // tutarı otomatik olarak o şantiyenin Proje Maliyeti toplam giderine eklenir
  // (akaryakıt fişi etiketleme mantığının aynısı).
  santiyeId       String?
  santiye         Santiye?          @relation(fields: [santiyeId], references: [id])
  // Piyasa Cari Durumu: karşı taraf tekrar seçilebilsin ve IBAN otomatik
  // gelsin diye kayıtlı kişi/firma. cariEklensinMi işaretliyse bu faturanın
  // tutarı o carinin alacak/borç bakiyesine dahil edilir.
  cariId          String?
  cari            Cari?             @relation(fields: [cariId], references: [id])
  cariEklensinMi  Boolean           @default(false)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  @@index([tarih])
  @@index([vadeTarihi])
  @@index([odemeDurumu])
  @@index([tur])
  @@index([sirketId])
  @@index([santiyeId])
  @@index([cariId])
}

// Piyasa Cari Durumu: "kim faturayı kesti / kime kestik" bilgisini tekrar
// girmemek için saklanan kişi/firma kaydı — IBAN'ı da üzerinde tutar, fatura
// formunda seçildiğinde otomatik doldurulsun diye. Fatura tutarlarından
// (cariEklensinMi işaretliyse) ve CariOdeme kayıtlarından net bakiye
// (alacak/borç) hesaplanır.
model Cari {
  id            String       @id @default(cuid())
  ad            String       @unique
  ibanBilgisi   String?
  aciklama      String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  faturalar     Fatura[]
  odemeler      CariOdeme[]
}

// Bir cari ile aramızdaki kısmi ödemeleri kaydeder (fatura tutarının
// tamamı bir kerede ödenmemiş/tahsil edilmemiş olabilir).
// TAHSILAT: bizim alacağımızdan düşer (karşı taraf bize ödedi)
// ODEME:    bizim borcumuzdan düşer (biz karşı tarafa ödedik)
model CariOdeme {
  id         String         @id @default(cuid())
  cariId     String
  cari       Cari           @relation(fields: [cariId], references: [id])
  tarih      DateTime
  tutar      Float
  yon        CariOdemeYonu
  // Nakit / Havale-EFT / Çek — Tom bazen borcunu çek vererek kapatıyor, bu
  // durumda ödemenin şekli burada not düşülür (tutarın bakiyeden düşme
  // mantığı hepsinde aynı, sadece nasıl ödendiği/tahsil edildiği kaydedilir).
  odemeSekli String?
  aciklama   String?
  createdAt  DateTime       @default(now())

  @@index([cariId])
  @@index([tarih])
}

enum CariOdemeYonu {
  TAHSILAT
  ODEME
}

// Haftalık Ödemeler görünümünde faturaya bağlı olmadan elle girilen ödeme
// kalemleri (ör. personele elden verilen haftalık harcama, fatura kesilmeyen
// nakliye/hizmet bedeli). Faturalar sekmesindeki ALINAN faturalarla birlikte,
// şirket + hafta bazında gruplanarak gösterilir.
model HaftalikOdeme {
  id            String    @id @default(cuid())
  tarih         DateTime
  odemeTarihi   DateTime?
  yapilanIs     String
  firma         String?
  ibanBilgisi   String?
  tutar         Float
  yuklenici     String?
  sirketId      String
  sirket        Sirket    @relation(fields: [sirketId], references: [id])
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([tarih])
  @@index([sirketId])
}

// ---------------------------------------------------------------------------
// Proje Maliyeti: şantiye bazında kâr/zarar takibi. Excel'deki "gerekli
// miktar / kullanılan miktar" malzeme mantığı + araçların günlük çalışma
// takibi (yalnız çalıştığı gün için yevmiye) + personel/nakliye/akaryakıt/
// gelir tek özet kaydında; İhale'nin hakediş toplamından bağımsız, sahada
// gerçekleşen maliyeti göstermek içindir.
// ---------------------------------------------------------------------------

// Şantiyenin malzeme ihtiyacı (uzunluk x genişlik x derinlik'ten hesaplanan
// "gerekli miktar") ile sahada fiilen tüketilen "kullanılan miktar"ı ayrı
// tutar; maliyet KULLANILAN miktar üzerinden hesaplanır.
model ProjeMalzeme {
  id               String   @id @default(cuid())
  santiyeId        String
  santiye          Santiye  @relation(fields: [santiyeId], references: [id], onDelete: Cascade)
  // Doldurulmuşsa bu kalem İş Kayıtlarından otomatik besleniyor demektir:
  // kullanilanMiktar, o şantiye + iş türü için girilen tüm İş Kayıtları'nın
  // miktar toplamıyla senkron tutulur (bkz. lib/proje-malzeme-sync.ts).
  // Elle eklenen kalemlerde bu alan boştur.
  isTuruId         String?
  isTuru           IsTuru?  @relation(fields: [isTuruId], references: [id])
  kalem            String
  uzunluk          Float?
  genislik         Float?
  derinlik         Float?
  gerekliMiktar    Float?
  kullanilanMiktar Float    @default(0)
  birim            String
  birimFiyat       Float    @default(0)
  aciklama         String?
  siraNo           Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([santiyeId])
  @@index([isTuruId])
}

// Şantiye başına, PIN korumalı "Personel Harcamaları" alt bölümündeki
// kişi/tarih/bölge bazlı harcama kayıtları (Tom'un Excel'indeki yapı).
model ProjePersonelHarcama {
  id          String   @id @default(cuid())
  santiyeId   String
  santiye     Santiye  @relation(fields: [santiyeId], references: [id], onDelete: Cascade)
  tarih       DateTime
  personelAdi String
  bolge       String?
  aciklama    String?
  tutar       Float
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([santiyeId])
  @@index([tarih])
}

// Bir aracın bu şantiyede takip edilip edilmediğini ve günlük kiralama
// bedelini tutar (kepçe, kamyon, paletli vb.). Bir araç birden çok
// şantiyede farklı bedelle takip edilebilir.
model ProjeArac {
  id          String   @id @default(cuid())
  santiyeId   String
  santiye     Santiye  @relation(fields: [santiyeId], references: [id], onDelete: Cascade)
  aracId      String
  arac        Arac     @relation(fields: [aracId], references: [id])
  gunlukBedel Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([santiyeId, aracId])
  @@index([santiyeId])
}

// Bir aracın belirli bir günde bu şantiyede çalışıp çalışmadığı. Yalnız
// çalıştığı günler için yevmiye maliyete yansır.
model ProjeAracGun {
  id        String   @id @default(cuid())
  santiyeId String
  santiye   Santiye  @relation(fields: [santiyeId], references: [id], onDelete: Cascade)
  aracId    String
  arac      Arac     @relation(fields: [aracId], references: [id])
  tarih     DateTime
  calisti   Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([santiyeId, aracId, tarih])
  @@index([santiyeId])
  @@index([tarih])
}

// Şantiye başına tek özet kayıt: nakliye, personel, akaryakıt ve gelir
// (hakediş). Kâr/zarar = gelir - (malzeme + araç + nakliye + personel + akaryakıt).
model ProjeMaliyetOzet {
  id                  String   @id @default(cuid())
  santiyeId           String   @unique
  santiye             Santiye  @relation(fields: [santiyeId], references: [id], onDelete: Cascade)

  gelir               Float    @default(0)

  seferSayisi         Int      @default(0)
  seferBasiUcret      Float    @default(0)

  personelSayisi      Int      @default(0)
  calisilanGun        Int      @default(0)
  gunlukUcret         Float    @default(0)
  digerHarcamalar     Float    @default(0)

  akaryakitLitre      Float    @default(0)
  akaryakitTutar      Float    @default(0)

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

// Tom'un Proje Maliyeti'ne kendi eklediği serbest/ekstra maliyet kalemleri
// (yukarıdaki sabit kategorilere (malzeme/araç/nakliye/personel/akaryakıt)
// girmeyen her türlü ek gider) — toplam gidere doğrudan eklenir.
model ProjeEkMaliyet {
  id        String   @id @default(cuid())
  santiyeId String
  santiye   Santiye  @relation(fields: [santiyeId], references: [id], onDelete: Cascade)
  ad        String
  tutar     Float    @default(0)
  aciklama  String?
  tarih     DateTime @default(now())
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([santiyeId])
}
